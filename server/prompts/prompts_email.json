{
    "schema_version": "2.1.0",
    "globals": {
        "core_frameworks": [
            "NEWSLETTER",
            "PROMO_BANNER",
            "WELCOME",
            "ANNOUNCEMENT",
            "SEASONAL"
        ]
    },
    "platforms": {
        "meta": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "PROMO_BANNER"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "16:9",
                    "1:1"
                ]
            },
            "creative_rules": "Email-style promotional banner. Clean professional design."
        },
        "instagram": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "ANNOUNCEMENT"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "1:1"
                ]
            },
            "creative_rules": "Newsletter preview card. Clean brand design."
        },
        "facebook": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "NEWSLETTER",
                "PROMO_BANNER"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "16:9"
                ]
            },
            "creative_rules": "Email header style banner. Subscribe CTA."
        },
        "tiktok": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "ANNOUNCEMENT"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "9:16"
                ]
            },
            "creative_rules": "Newsletter teaser post."
        },
        "youtube": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "PROMO_BANNER"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "16:9"
                ]
            },
            "creative_rules": "Email header banner style."
        },
        "pinterest": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "NEWSLETTER"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "2:3"
                ]
            },
            "creative_rules": "Newsletter signup visual."
        },
        "x": {
            "accepted_content_types": [
                "image"
            ],
            "best_ad_frameworks": [
                "ANNOUNCEMENT"
            ],
            "format_rules": {
                "aspect_ratios": [
                    "16:9"
                ]
            },
            "creative_rules": "Newsletter or email announcement."
        }
    },
    "niches": {
        "general": {
            "core_emotion": "professional_and_inviting",
            "visual_direction": {
                "lighting": "clean professional",
                "colors": [
                    "brand-appropriate",
                    "white",
                    "accent color"
                ],
                "scenarios": [
                    "email header banner",
                    "newsletter hero image",
                    "promotional graphic",
                    "welcome email visual"
                ]
            },
            "master_prompt": "Design a professional email header or newsletter banner for {{ .Title }}. Wide 16:9 or 600px-wide email format. Clean professional design with brand-appropriate colors. Bold headline text about {{ .Description }}. Clean imagery or illustration supporting the message. CTA button element (Subscribe, Read More, Shop Now). This must look like a professional email marketing header — clean, trustworthy, and compelling. Horizontal banner format.",
            "video_prompt": "Animated email header for {{ .Title }}. Subtle motion graphics. Text reveal. Professional newsletter feel. {{ .Description }}.",
            "carousel_prompt": "Email campaign visual series for {{ .Title }}. Slide 1: Hero banner with headline about {{ .Description }}. Slide 2: Key benefit visual. Slide 3: Feature highlight. Slide 4: CTA banner. Professional email marketing quality.",
            "caption_templates": [
                "New in your inbox 📧 {{ .Title }}. {{ .Description }}",
                "This week's newsletter: {{ .Title }} 📬",
                "Exclusive for subscribers — {{ .Title }}. {{ .Description }}"
            ],
            "platform_adaptation": {
                "meta": "Email header style. Clean professional.",
                "instagram": "Newsletter preview card.",
                "facebook": "Email banner. Subscribe CTA.",
                "x": "Newsletter announcement graphic."
            },
            "product_rule": "email marketing format, horizontal banner, professional and clean"
        },
        "beauty_skincare": {
            "core_emotion": "exclusive_and_premium",
            "visual_direction": {
                "lighting": "soft elegant",
                "colors": [
                    "pastel pink",
                    "gold",
                    "cream"
                ],
                "scenarios": [
                    "beauty newsletter header",
                    "exclusive offer banner",
                    "new collection email"
                ]
            },
            "master_prompt": "Design a premium beauty email banner for {{ .Title }}. Elegant horizontal format. Soft pastel or cream background. Bold headline about {{ .Description }}. Product imagery integrated elegantly. Exclusive offer or new arrival feel. CTA button. Professional beauty email marketing quality.",
            "video_prompt": "Beauty newsletter header animation for {{ .Title }}. Elegant product reveal. Soft motion. Premium feel. {{ .Description }}.",
            "carousel_prompt": "Beauty email campaign for {{ .Title }}. Slide 1: Elegant announcement banner. Slide 2: Product preview. Slide 3: Benefits. Slide 4: Exclusive CTA. {{ .Description }}.",
            "caption_templates": [
                "Exclusive for our subscribers ✨ {{ .Title }}",
                "New drop alert 📧 {{ .Title }}. {{ .Description }}",
                "Check your inbox — {{ .Title }} is here 💌"
            ],
            "platform_adaptation": {
                "meta": "Elegant promo banner.",
                "instagram": "Newsletter preview aesthetic."
            },
            "product_rule": "email banner format, elegant professional, horizontal layout"
        }
    }
}